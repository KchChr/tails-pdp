policy "deny python3 socket_bind on 0.0.0.0:8080 tcp for uid 1000 at DEFCON 2 or lower"
deny
    action == "socket_bind";
    subject.uid == 1000;
    command == "python3";
    resource.family == "inet";
    resource.transport == "tcp";
    resource.ip == "0.0.0.0";
    resource.port == 8080;
    environment.defcon.level <= 2;
